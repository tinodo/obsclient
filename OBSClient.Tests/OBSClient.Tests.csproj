<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>OBSStudioClient.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.1.0" />
    <!-- nuget.org renders the README of the package with Markdig: ReadmeTests parse it with the same parser. -->
    <PackageReference Include="Markdig" Version="1.4.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OBSClient\OBSClient.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The parts of the test app (OBSClient.TestApp) that do not depend on WinUI are compiled into these tests as well. The app
      itself only builds on Windows, but its catalog of requests and events (generated from the protocol) and its comparison of
      JSON are checked on every platform, on every build.
    -->
    <Compile Include="..\OBSClient.TestApp\Analysis\JsonShape.cs" Link="TestApp\Linked\JsonShape.cs" />
    <Compile Include="..\OBSClient.TestApp\Services\JsonTools.cs" Link="TestApp\Linked\JsonTools.cs" />
    <Compile Include="..\OBSClient.TestApp\Services\FrameInfo.cs" Link="TestApp\Linked\FrameInfo.cs" />
    <Compile Include="..\OBSClient.TestApp\Services\LogEntry.cs" Link="TestApp\Linked\LogEntry.cs" />
    <Compile Include="..\OBSClient.TestApp\Services\EventPairing.cs" Link="TestApp\Linked\EventPairing.cs" />
    <Compile Include="..\OBSClient.TestApp\Services\ObservationStore.cs" Link="TestApp\Linked\ObservationStore.cs" />
    <Compile Include="..\OBSClient.TestApp\Services\SessionExporter.cs" Link="TestApp\Linked\SessionExporter.cs" />
    <Compile Include="..\OBSClient.TestApp\Services\AppSettings.cs" Link="TestApp\Linked\AppSettings.cs" />
    <Compile Include="..\OBSClient.TestApp\Catalog\*.cs" Link="TestApp\Linked\Catalog\%(Filename)%(Extension)" />
    <Compile Include="..\OBSClient.TestApp\Generated\*.g.cs" Link="TestApp\Linked\Generated\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- A compact snapshot of the obs-websocket protocol, generated by tools/protocol/generate.py. -->
    <EmbeddedResource Include="Protocol\protocol.schema.json" LogicalName="protocol.schema.json" />
    <!-- The README of the package, which nuget.org shows as the page of the package (see ReadmeTests). -->
    <EmbeddedResource Include="..\README.md" LogicalName="README.md" />
    <!-- What a real OBS Studio answered (see ObsStudioCaptureTests): one file for each capture. -->
    <EmbeddedResource Include="Fixtures\obs-capture-*.json" LogicalName="%(Filename)%(Extension)" />
  </ItemGroup>

</Project>