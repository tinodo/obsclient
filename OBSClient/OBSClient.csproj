<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>OBSStudioClient</RootNamespace>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Title>OBS Studio Client</Title>
    <Authors>tinod</Authors>
    <Description>A Complete cross platform .NET WebSocket Client for OBS Studio version 28 and up.</Description>
    <PackageProjectUrl>https://tinodo.github.io/obsclient/</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/tinodo/obsclient.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>obs</PackageTags>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <Version>4.0.0-beta1</Version>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
	<PublishRepositoryUrl>true</PublishRepositoryUrl>
	<EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Requests\**" />
    <EmbeddedResource Remove="Requests\**" />
    <None Remove="Requests\**" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\LICENSE">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- The client only takes an ILogger<ObsClient>, so it needs the abstractions and not the logging system itself. The version is the
         oldest that has what the client uses: a library that asks for a newer one makes every application that uses it update too
         (and breaks the restore of one that pins an older one). Dependabot leaves it alone, see .github/dependabot.yml. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>OBSClient.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>

