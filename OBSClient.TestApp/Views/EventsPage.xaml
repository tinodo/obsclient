<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="OBSStudioClient.TestApp.Views.EventsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:svc="using:OBSStudioClient.TestApp.Services">

    <Grid Padding="24,16,24,24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Events" />
            <TextBlock
                Style="{StaticResource SecondaryBodyStyle}"
                Text="Every event of OBS Studio as the client raises it, with what the client made of it and what OBS Studio sent. Choose the events to receive on the Connection page." />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <AutoSuggestBox
                x:Name="FilterBox"
                PlaceholderText="Filter by name, category or content"
                QueryIcon="Find"
                TextChanged="FilterBox_TextChanged" />
            <ToggleButton
                x:Name="PauseButton"
                Grid.Column="1"
                Content="Pause"
                Click="PauseButton_Click" />
            <Button
                Grid.Column="2"
                Click="ClearButton_Click"
                Content="Clear" />
            <TextBlock
                x:Name="CountText"
                Grid.Column="3"
                VerticalAlignment="Center"
                Style="{StaticResource SecondaryCaptionStyle}" />
        </Grid>

        <Grid Grid.Row="2" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CardStyle}" Padding="0">
                <ListView
                    x:Name="EventList"
                    ItemsSource="{x:Bind Visible}"
                    SelectionChanged="EventList_SelectionChanged"
                    SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="svc:SessionEvent">
                            <Grid Padding="0,4" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="92" />
                                    <ColumnDefinition Width="230" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    FontFamily="{StaticResource CodeFontFamily}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind TimeText}" />
                                <TextBlock
                                    Grid.Column="1"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="{x:Bind Name}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Grid.Column="2"
                                    Style="{StaticResource SecondaryCaptionStyle}"
                                    Text="{x:Bind Summary}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        x:Name="DetailTitle"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="Select an event" />
                    <SelectorBar x:Name="DetailTabs" Grid.Row="1" SelectionChanged="DetailTabs_SelectionChanged">
                        <SelectorBarItem
                            x:Name="TypedTab"
                            IsSelected="True"
                            Text="Returned by the client" />
                        <SelectorBarItem x:Name="RawTab" Text="Sent by OBS Studio" />
                    </SelectorBar>
                    <TextBox
                        x:Name="DetailBox"
                        Grid.Row="2"
                        IsReadOnly="True"
                        Style="{StaticResource CodeTextBoxStyle}" />
                    <Button
                        Grid.Row="3"
                        HorizontalAlignment="Left"
                        Click="CopyButton_Click"
                        Content="Copy" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
