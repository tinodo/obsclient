<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="OBSStudioClient.TestApp.Views.ExplorerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Padding="16,16,8,16" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <AutoSuggestBox
                x:Name="SearchBox"
                AutomationProperties.Name="Search the requests"
                PlaceholderText="Search the requests"
                QueryIcon="Find"
                TextChanged="SearchBox_TextChanged" />
            <Grid Grid.Row="1">
                <TreeView
                    x:Name="RequestTree"
                    AutomationProperties.Name="Requests of the protocol, by category"
                    ItemInvoked="RequestTree_ItemInvoked"
                    SelectionMode="Single" />
                <TextBlock
                    x:Name="NoMatchText"
                    Margin="8,16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Style="{StaticResource SecondaryBodyStyle}"
                    Text="No request matches the search. The search looks at the names and the descriptions."
                    TextAlignment="Center"
                    Visibility="Collapsed" />
            </Grid>
        </Grid>

        <ScrollViewer Grid.Column="1">
            <StackPanel
                MaxWidth="1000"
                Padding="8,16,24,24"
                HorizontalAlignment="Left"
                Spacing="16">

                <StackPanel x:Name="WelcomePanel" Spacing="4">
                    <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Explorer" />
                    <TextBlock
                        Style="{StaticResource SecondaryBodyStyle}"
                        Text="Choose a request on the left to fill in its parameters and send it to OBS Studio. The result is shown as the client returns it, next to what OBS Studio sent, and compared. Requests can also be put in a batch, to send them together from the Batch page." />
                </StackPanel>

                <StackPanel
                    x:Name="DetailPanel"
                    Spacing="16"
                    Visibility="Collapsed">

                    <StackPanel Spacing="4">
                        <TextBlock x:Name="RequestTitle" Style="{StaticResource TitleTextBlockStyle}" />
                        <TextBlock x:Name="RequestMeta" Style="{StaticResource SecondaryCaptionStyle}" />
                        <TextBlock x:Name="RequestDescription" Style="{StaticResource SecondaryBodyStyle}" />
                    </StackPanel>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="16">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="Parameters" />
                                <Button
                                    x:Name="RefreshButton"
                                    Grid.Column="1"
                                    Click="RefreshButton_Click"
                                    Content="Refresh scenes and inputs" />
                            </Grid>
                            <TextBlock
                                x:Name="NoParameters"
                                Style="{StaticResource SecondaryBodyStyle}"
                                Text="This request has no parameters." />
                            <StackPanel x:Name="FormHost" />
                        </StackPanel>
                    </Border>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button
                            x:Name="InvokeButton"
                            Click="InvokeButton_Click"
                            Content="Send request"
                            Style="{StaticResource AccentButtonStyle}">
                            <Button.KeyboardAccelerators>
                                <KeyboardAccelerator Key="Enter" Modifiers="Control" />
                            </Button.KeyboardAccelerators>
                        </Button>
                        <Button
                            x:Name="BatchButton"
                            Grid.Column="1"
                            Click="BatchButton_Click"
                            Content="Add to batch" />
                        <ProgressRing
                            x:Name="Busy"
                            Grid.Column="2"
                            Width="20"
                            Height="20"
                            AutomationProperties.Name="Waiting for OBS Studio"
                            IsActive="False" />
                        <TextBlock
                            x:Name="StatusLine"
                            Grid.Column="3"
                            VerticalAlignment="Center"
                            Style="{StaticResource SecondaryBodyStyle}" />
                    </Grid>

                    <InfoBar
                        x:Name="ProblemBar"
                        IsOpen="False"
                        Severity="Warning" />

                    <Border
                        x:Name="ResultCard"
                        Style="{StaticResource CardStyle}"
                        Visibility="Collapsed">
                        <StackPanel Spacing="12">
                            <SelectorBar x:Name="ResultTabs" SelectionChanged="ResultTabs_SelectionChanged">
                                <SelectorBarItem
                                    x:Name="TypedTab"
                                    IsSelected="True"
                                    Text="Client" />
                                <SelectorBarItem x:Name="RawTab" Text="OBS Studio" />
                                <SelectorBarItem x:Name="ComparisonTab" Text="Comparison" />
                            </SelectorBar>
                            <TextBlock x:Name="TabCaption" Style="{StaticResource SecondaryCaptionStyle}" />
                            <TextBox
                                x:Name="ResultBox"
                                MinHeight="280"
                                MaxHeight="520"
                                AutomationProperties.Name="Result"
                                IsReadOnly="True"
                                Style="{StaticResource CodeTextBoxStyle}" />
                            <Button
                                x:Name="CopyButton"
                                HorizontalAlignment="Left"
                                Click="CopyButton_Click"
                                Content="Copy" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
