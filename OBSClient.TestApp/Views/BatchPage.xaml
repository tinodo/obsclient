<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="OBSStudioClient.TestApp.Views.BatchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:svc="using:OBSStudioClient.TestApp.Services"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel
            MaxWidth="1000"
            Padding="24,16,24,24"
            HorizontalAlignment="Left"
            Spacing="16">

            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Batch" />
                <TextBlock
                    Style="{StaticResource SecondaryBodyStyle}"
                    Text="A batch sends several requests to OBS Studio as one message; OBS Studio runs them and answers with one message that holds the response of each. Put requests in the batch with Add to batch on the Explorer page, arrange them here, and send the batch." />
            </StackPanel>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="CountText"
                            VerticalAlignment="Center"
                            Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <Button
                            x:Name="MoveUpButton"
                            Grid.Column="1"
                            Click="MoveUpButton_Click"
                            Content="Move up" />
                        <Button
                            x:Name="MoveDownButton"
                            Grid.Column="2"
                            Click="MoveDownButton_Click"
                            Content="Move down" />
                        <Button
                            x:Name="RemoveButton"
                            Grid.Column="3"
                            Click="RemoveButton_Click"
                            Content="Remove" />
                        <Button
                            x:Name="ClearButton"
                            Grid.Column="4"
                            Click="ClearButton_Click"
                            Content="Clear all" />
                    </Grid>
                    <Grid>
                        <ListView
                            x:Name="ItemList"
                            MinHeight="120"
                            MaxHeight="320"
                            AutomationProperties.Name="Requests in the batch"
                            ItemsSource="{x:Bind Items}"
                            SelectionChanged="ItemList_SelectionChanged"
                            SelectionMode="Single">
                            <ListView.ItemContainerStyle>
                                <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                                    <Setter Property="MinHeight" Value="28" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="svc:BatchItem">
                                    <Grid Padding="0,4" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" MinWidth="200" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Style="{StaticResource BodyStrongTextBlockStyle}"
                                            Text="{x:Bind Title}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource SecondaryCaptionStyle}"
                                            Text="{x:Bind Summary}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="NoWrap" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock
                            x:Name="EmptyText"
                            Margin="24"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False"
                            Style="{StaticResource SecondaryBodyStyle}"
                            Text="The batch is empty. Choose a request on the Explorer page, fill in its parameters and choose Add to batch."
                            TextAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="16">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="How OBS Studio runs the batch" />
                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="8">
                            <ComboBox
                                x:Name="ExecutionBox"
                                HorizontalAlignment="Stretch"
                                AutomationProperties.Name="Execution type"
                                Header="Execution type"
                                SelectionChanged="ExecutionBox_SelectionChanged" />
                            <TextBlock x:Name="ExecutionNote" Style="{StaticResource SecondaryCaptionStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="12">
                            <ToggleSwitch
                                x:Name="HaltSwitch"
                                AutomationProperties.Name="Stop at the first request that fails"
                                Header="Stop at the first request that fails"
                                OffContent="No, run every request"
                                OnContent="Yes, stop" />
                            <TextBlock
                                Style="{StaticResource SecondaryCaptionStyle}"
                                Text="When the batch stops, OBS Studio answers only for the requests that it ran, the one that failed included." />
                            <TextBox
                                x:Name="TimeoutBox"
                                AutomationProperties.Name="Timeout in milliseconds"
                                Header="Timeout in milliseconds (optional)"
                                IsSpellCheckEnabled="False"
                                PlaceholderText="the request timeout of the client" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button
                    x:Name="SendButton"
                    Click="SendButton_Click"
                    Content="Send batch"
                    Style="{StaticResource AccentButtonStyle}">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Enter" Modifiers="Control" />
                    </Button.KeyboardAccelerators>
                </Button>
                <ProgressRing
                    x:Name="Busy"
                    Grid.Column="1"
                    Width="20"
                    Height="20"
                    AutomationProperties.Name="Waiting for OBS Studio"
                    IsActive="False" />
                <TextBlock
                    x:Name="StatusLine"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Style="{StaticResource SecondaryBodyStyle}" />
            </Grid>

            <InfoBar
                x:Name="ProblemBar"
                IsOpen="False"
                Severity="Warning" />

            <Border
                x:Name="ResultCard"
                Style="{StaticResource CardStyle}"
                Visibility="Collapsed">
                <StackPanel Spacing="12">
                    <SelectorBar x:Name="ResultTabs" SelectionChanged="ResultTabs_SelectionChanged">
                        <SelectorBarItem
                            x:Name="TypedTab"
                            IsSelected="True"
                            Text="Client" />
                        <SelectorBarItem x:Name="RawTab" Text="OBS Studio" />
                        <SelectorBarItem x:Name="ComparisonTab" Text="Comparison" />
                    </SelectorBar>
                    <TextBlock x:Name="TabCaption" Style="{StaticResource SecondaryCaptionStyle}" />
                    <TextBox
                        x:Name="ResultBox"
                        MinHeight="280"
                        MaxHeight="520"
                        AutomationProperties.Name="Result"
                        IsReadOnly="True"
                        Style="{StaticResource CodeTextBoxStyle}" />
                    <Button
                        x:Name="CopyButton"
                        HorizontalAlignment="Left"
                        Click="CopyButton_Click"
                        Content="Copy" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
