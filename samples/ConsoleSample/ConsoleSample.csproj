<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!--
    Normally the sample uses the project of the library (dotnet run, from this folder).
    CI builds it the way a consumer of the package does: with the property OBSClientVersion set to the version of the package, and
    the folder of the package that was just packed as the only source. That is what shows that the package can be used.
  -->

  <ItemGroup Condition="'$(OBSClientVersion)' == ''">
    <ProjectReference Include="..\..\OBSClient\OBSClient.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(OBSClientVersion)' != ''">
    <PackageReference Include="OBSClient" Version="$(OBSClientVersion)" />
  </ItemGroup>

</Project>
